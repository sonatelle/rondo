# Rust
/target/

# Nix / direnv
/.direnv/
result

# macOS
.DS_Store

# Xcode
xcuserdata/
DerivedData/
build/

# Generated from apple/project.yml by xcodegen; a project file is thousands
# of lines of UUID references that cannot be merged, so the spec is the
# source and this is output.
/apple/Rondo.xcodeproj/

# Written by `xcode-build-server config` so sourcekit-lsp can find the
# build. It records absolute paths to this checkout, this machine's
# DerivedData, and wherever the tool happens to be installed, so it is
# per-machine and belongs to whoever generated it.
/apple/buildServer.json

# Generated FFI artifacts (built by scripts/build-xcframework.sh)
/apple/RondoCore/

# Disk images built by scripts/package-dmg.sh. A release carries them
# as attachments; the repository does not carry them at all.
/dist/
