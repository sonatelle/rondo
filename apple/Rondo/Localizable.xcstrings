    },
    "Restoring merges and never deletes, so opening the wrong file cannot cost you data." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复只合并、不删除，打开错文件也不会丢数据。"
